bin
obj
.idea
bundles
.vs
*.user
*.tmp
launchSettings.json

# Configuration convention: appsettings.json carries localhost defaults only and
# IS tracked, so a fresh clone builds and runs. Anything that is a real
# credential in any environment has no in-repo default and comes from DM_* env
# vars or a secrets/ file; a missing value fails at startup rather than falling
# back to a value everyone can read. Blanket-ignoring appsettings.json is what
# left the worker projects without configuration on a fresh clone.
appsettings.Local.json
appsettings.*.local.json
secrets/

# Nginx credentials
docker/nginx/.htpasswd

# Docker environment secrets
docker/.env
docker/.env.mirror

# Claude Code plans
.claude/

# Build artifacts: the OpenAPI contract is emitted by the integration suite
# and uploaded by CI, not committed - a checked-in copy goes stale silently.
artifacts/

# Test artifacts
test_*.json
cookies*.txt
*_response.json

# TypeScript incremental build state — regenerated by every type-check
*.tsbuildinfo

# Windows null device artifact. Case-insensitive on purpose: the file is created
# as NUL, and a lowercase pattern only matches it on a case-insensitive checkout.
[Nn][Uu][Ll]


# OWASP ZAP scan scratch output (created by zap-baseline.py in CI and locally)
zap.yaml
report_json.json
report_md.md
report_html.html

# Playwright: отчеты и артефакты прогонов
src/DM.Web.Client/test-results/
src/DM.Web.Client/playwright-report/
src/DM.Web.Client/blob-report/

src/DM.Web.Client/e2e/.auth/
