bin
obj
.idea
.vs
*.user
*.tmp
launchSettings.json

# appsettings.json is tracked with localhost defaults, so a fresh clone builds. Real
# credentials have no in-repo default: a missing one fails the start. The localhost
# values of the keys a host cannot start without live in appsettings.Development.json.
appsettings.Local.json
appsettings.*.local.json
secrets/

# Generated on the host and never committed: a hash committed once stays in history
# whatever the ignore says.
docker/nginx/.htpasswd

# Written by docker/scripts/init-ssl.sh and by the certificate challenge: they belong
# to the machine, not to the repository.
docker/nginx/tls/*
!docker/nginx/tls/.gitkeep
docker/nginx/acme/*
!docker/nginx/acme/.gitkeep

docker/.env
docker/.env.pop

# The agent configuration is versioned; only machine- and session-local files stay out.
.claude/settings.local.json
.claude/*.doctor-backup
.claude/worktrees/

# Build output. The snapshots below are tracked on purpose: the client test compares
# its models to the contract and the routes gate runs in a job with a separate checkout.
artifacts/*
!artifacts/openapi-contract.json
!artifacts/openapi-routes.json
!artifacts/openapi-public-routes.json

# Test run output; the coverage script wants the directory fresh.
TestResults/

# Vitest run-state cache: one machine's timings.
src/.vite/

*.tsbuildinfo

# Created as NUL by Windows tools; the pattern is case-insensitive because a lowercase
# one matches it on a case-insensitive checkout only.
[Nn][Uu][Ll]

# OWASP ZAP scratch output
zap.yaml
report_json.json
report_md.md
report_html.html

src/DM.Web.Client/test-results/
src/DM.Web.Client/playwright-report/
src/DM.Web.Client/blob-report/

src/DM.Web.Client/e2e/.auth/
