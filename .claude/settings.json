{
  "permissions": {
    "deny": [
      "Bash(git checkout:*)",
      "Bash(git reset --hard:*)",
      "Bash(git reset --merge:*)",
      "Bash(git clean:*)",
      "Bash(git restore:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch --delete --force:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git gc:*)",
      "Bash(git prune:*)",
      "Bash(git reflog expire:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(python *)",
      "Bash(python3 *)",
      "PowerShell(python *)",
      "PowerShell(python3 *)",
      "Skill(anthropic-skills:jahro-commands)",
      "Skill(anthropic-skills:jahro-logging)",
      "Skill(anthropic-skills:jahro-migration)",
      "Skill(anthropic-skills:jahro-production)",
      "Skill(anthropic-skills:jahro-setup)",
      "Skill(anthropic-skills:jahro-snapshots)",
      "Skill(anthropic-skills:jahro-troubleshooting)",
      "Skill(anthropic-skills:jahro-watcher)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous-git.js\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-new-migrations.js\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-in-subagents.js\""
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-new-migrations.js\""
          }
        ]
      },
      {
        "matcher": "mcp__Claude_Browser__.*|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-in-subagents.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-edited-file.js\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": true
  }
}
