<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="FluentAssertions" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\DM.Infrastructure.Core\DM.Infrastructure.Core.csproj" />
        <ProjectReference Include="..\DM.Testing\DM.Testing.csproj" />
      <ProjectReference Include="..\..\src\DM.Infrastructure.Messaging\DM.Infrastructure.Messaging.csproj" />
      <!-- SearchIndexer worker has no dedicated test project; its single
           AutoMapper profile is covered from here (closest worker-side
           infrastructure test project) via assembly scanning. -->
      <ProjectReference Include="..\..\src\DM.Workers.SearchIndexer\DM.Workers.SearchIndexer.csproj" />
      <!-- Same reasoning for the notification dispatcher: its queue binding is
           derived from the generator types, and that derivation is what these
           tests hold in place. -->
      <ProjectReference Include="..\..\src\DM.Workers.NotificationDispatcher\DM.Workers.NotificationDispatcher.csproj" />
    </ItemGroup>

</Project>
