<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DM.Testing\DM.Testing.csproj" />
        <!-- What this project tests is what belongs to this host: the letter its
             processor builds and the line it writes about one. The processor is
             internal and the props grant its internals to this assembly by name. The
             middleware both workers consume through belongs to the broker side and is
             tested there, in DM.Infrastructure.Messaging.Tests. -->
        <ProjectReference Include="..\..\src\DM.Workers.Mail\DM.Workers.Mail.csproj" />
    </ItemGroup>

</Project>
