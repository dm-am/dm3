<Project>
    <!-- Inherit every version from the solution-wide file. A second independent
         package list here let test and src drift apart, and kept transitive
         pinning — and therefore security patches — from ever reaching the test
         projects. Only packages that exist nowhere in src belong below. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Packages.props', '$(MSBuildThisFileDirectory)../'))" />

    <ItemGroup>
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="8.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    </ItemGroup>
</Project>
