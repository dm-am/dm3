<Project>
    <!-- MSBuild takes the nearest Directory.Build.props only, so the solution
         wide settings must be imported explicitly or test projects would lose
         them (TreatWarningsAsErrors, nullable, InternalsVisibleTo). -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <ItemGroup>
        <!-- The extension behind the coverage switch of dotnet test. DM.Testing is a
             library and no test application, so it does not take it. -->
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage"
                          Condition="'$(MSBuildProjectName)' != 'DM.Testing'" />
        <!-- The NSubstitute guard belongs here and not next to the library:
             analyzer assets are private by default, so they never arrive with
             the transitive NSubstitute the domain suites get through DM.Testing
             - exactly the projects that hold most of the mocking code. It never
             ships as a runtime dependency. -->
        <PackageReference Include="NSubstitute.Analyzers.CSharp">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
</Project>
