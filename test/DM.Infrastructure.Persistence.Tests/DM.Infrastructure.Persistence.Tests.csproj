<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" />
        <!-- A test double for repository code whose assertion is about the query
             the code writes, where a mocked DbSet would assert the mock.
             Admissible while the same path also runs against Postgres in the
             integration tier, or while the defect is observable only because LINQ
             over objects enumerates in insertion order. What the database decides
             belongs in the Testcontainers tier. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\DM.Testing\DM.Testing.csproj" />
      <ProjectReference Include="..\..\src\DM.Infrastructure.Persistence\DM.Infrastructure.Persistence.csproj" />
    </ItemGroup>

</Project>
