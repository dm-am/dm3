<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <!-- The walk from the test binary up to the checkout is shared with the other
         test projects as source, not through a reference to DM.Testing. That project
         is built on NSubstitute, its assembly matches the DM.*.dll filter this tier's
         ArchUnit loader scans the output directory with, and the predicate that
         keeps test assemblies out of the production set excludes names ending in
         ".Tests", which "DM.Testing" does not. Compiling the one file keeps a single
         spelling of the walk and none of that. -->
    <ItemGroup>
        <Compile Include="..\DM.Testing\RepositoryLayout.cs" Link="RepositoryLayout.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" />
        <!-- The transport type the disposability rule matches on. It also arrives
             transitively through the mail worker, but a rule that stops compiling
             the day that project drops the package is not a rule. -->
        <PackageReference Include="MailKit" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="TngTech.ArchUnitNET" />
        <PackageReference Include="TngTech.ArchUnitNET.xUnitV3" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- The host project drags every Domain.* and Infrastructure.* assembly into
         the output directory, which is what the loader scans. The workers and the
         seeder are referenced on their own: nothing else pulls them in, so every
         rule was silently blind to three of the five executables. -->
    <ItemGroup>
      <ProjectReference Include="..\..\src\DM.Web.API\DM.Web.API.csproj" />
      <ProjectReference Include="..\..\src\DM.Workers.Mail\DM.Workers.Mail.csproj" />
      <ProjectReference Include="..\..\src\DM.Workers.NotificationDispatcher\DM.Workers.NotificationDispatcher.csproj" />
      <ProjectReference Include="..\..\src\DM.Tools.Seeder\DM.Tools.Seeder.csproj" />
    </ItemGroup>

</Project>
