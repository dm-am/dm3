# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Force specific file types to always use LF
*.cs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sass text eol=lf
*.scss text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.props text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
