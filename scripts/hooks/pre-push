#!/bin/sh
#
# Гоняет на пуше ветки гейты CI, которые имеет смысл гонять локально.
#
# В dev изменения попадают только слиянием PR, а PR сливается только при
# зеленом CI: это держит защита ветки. Хук дает тот же ответ раньше, о красном
# говорит пуш ветки, а не страница PR через полчаса. Пуш прямо в dev или main
# хук отвергает до всех гейтов.
#
# Набор e2e на ветке не идет: его гонит джоба e2e на PR, против стека,
# поднятого в ней самой. Локально он шел бы против стенда, а стенд перед
# каждым пушем ветки пришлось бы пересобирать под нее. Набор по своей воле,
# против своего стенда, дает DM_GATES_FULL=1 (ниже).
#
# Джобы обоих воркфлоу: "+" хук гоняет ее гейты, "-" не гоняет ни одного и
# говорит почему. Цена тут часть контракта: гейт на двадцать минут перестают
# запускать, а обойденный гейт не защищает ни от чего.
#
# Маркер "-" значит именно ноль: пока compose-topology стояла "-" целиком,
# внутри нее сидел shellcheck, которому нужен только docker, и его первым
# читателем становился красный CI. Строка на джобу прячет шаг ценой в секунды
# за ценой шага в минуты, поэтому шаги считаются поштучно —
# AgentToolingShould.RunEveryGateTheWorkflowRunsThatBelongsOnThisMachine.
#   changes           +  карта путей scripts/ci-paths.json: решает, какие
#                        гейты ниже нужны этому пушу, и печатает почему
#   docs              +  архитектурные тесты и юнит-тесты клиента, когда
#                        build не нужен: оба читают документы
#   build             +  форматирование, сборка и тесты решения в Release,
#                        порог покрытия. Сбор покрытия удлиняет прогон тестов,
#                        и это плата за то, чтобы порог не падал впервые в CI
#   frontend          +  синхронность lock-файла, линт, типы, юнит-тесты с
#                        порогом покрытия, сборка
#   dependency-scan   +  уязвимые пакеты .NET и npm
#   e2e               +  только с DM_GATES_FULL=1, на ветке его гонит CI на
#                        PR. Набор на одном профиле браузера и с настройками
#                        CI (один воркер, два повтора, запрет test.only)
#                        против поднятого стенда. Стенд хук не поднимает, а
#                        проверяет первым делом и при отказе печатает
#                        команду, которая его готовит
#   compose-topology  +  целиком: разбор скриптов, топология compose,
#                        конфигурации nginx, установщик сервера, мониторинг.
#                        Всей джобе нужен только docker, и идет она секунды
#   deployment-smoke  -  поднимает деплойную пару целиком: docker и минуты
#   publish           -  пишет образы в реестр по секретам GitHub
#   publish-frontend  -  то же
#   promote-images    -  двигает подвижные имена по дайджесту, в реестре
#   security          -  вызов security.yml из графа сборки; сам ничего не
#                        считает, ждет двух джоб ниже
#   codeql            -  анализ выполняется на стороне GitHub
#   zap-scan          -  сканирует поднятый стенд: docker и минуты
#
# Установка (один раз на клон):
#   git config core.hooksPath scripts/hooks
# Отключение:
#   git config --unset core.hooksPath
# Разовый обход, когда он осознан:
#   git push --no-verify
#
# Порядок гейтов — от самого дешевого к самому дорогому, чтобы падать раньше.
#
# Гейты идут не все, а те, что нужны изменениям пуша: git diff origin/dev...HEAD
# раскладывается по группам путей карты scripts/ci-paths.json, и карта решает,
# какие джобы CI нужны, тем же скриптом, что и джоба changes воркфлоу. Карта у
# них одна (AgentToolingShould.ReadOneMapOfPaths), и база та же, что у CI на PR:
# база слияния ветки с dev. Путь, которого карта не знает, и diff, который git
# не смог построить, дают полный набор. Полный набор по своей воле, e2e в том
# числе:
#   DM_GATES_FULL=1 git push

set -e

ROOT=$(git rev-parse --show-toplevel)
CLIENT="$ROOT/src/DM.Web.Client"

say() { printf '\n\033[36m==> %s\033[0m\n' "$1"; }

# Куда уходит пуш, git подает на stdin, строкой на ссылку: "<локальная ссылка>
# <sha> <удаленная ссылка> <sha>". dev и main принимают только слияния PR, и
# пуш в них отвергается раньше любого гейта: защита ветки отвергнет его тоже,
# но уже после того, как гейты отработали впустую.
while read -r _ _ remote_ref _; do
  case "$remote_ref" in
    refs/heads/dev | refs/heads/main)
      printf '\n\033[31m%s принимает только слияния PR: запушить ветку и открыть PR\033[0m\n' "${remote_ref#refs/heads/}" >&2
      exit 1
      ;;
  esac
done

# Первым и не из воркфлоу: этот хук — единственное, что стоит между запрещенной
# командой и потерянной работой, а его собственный тест до сих пор не гонял
# никто, ни локально, ни в CI. Проверка идет в обе стороны — каждая опасная
# форма блокируется, каждая безопасная проходит, — и стоит доли секунды, так
# что дешевле ее в списке нет.
say "Хуки: защита от разрушительных команд git"
node "$ROOT/.claude/hooks/block-dangerous-git.test.js"

say "Хуки: запрет второй миграции"
node "$ROOT/.claude/hooks/block-new-migrations.test.js"

say "Хуки: разбор пути для линта правки"
node "$ROOT/.claude/hooks/lint-edited-file.test.js"

# Решение карты: строка "<джоба>=true|false" на каждую джобу. Отчет о группах
# и о том, что пропущено и почему, скрипт печатает в stderr, то есть сюда же.
say "Пути: какие гейты нужны этому пушу"
SELECTION=$(node "$ROOT/scripts/ci-paths.mjs" --diff origin/dev...HEAD)

wants() { printf '%s\n' "$SELECTION" | grep -qx "$1=true"; }

# Набор e2e и проверка стенда под него идут только по своей воле. На ветке
# набор гонит джоба e2e на PR, против стека, поднятого в ней самой. Локально
# он шел бы против стенда, а проверка стенда сверяет коммит его API с пушем,
# так что ради каждого пуша ветки стенд пришлось бы пересобирать. Пуш в dev и
# main сюда не доходит, его отвергла проверка ссылок выше. Непустая
# DM_GATES_FULL зовет набор, как зовет и все джобы карты.
e2e_requested() { [ -n "${DM_GATES_FULL:-}" ]; }

# Стенд для e2e проверяется здесь, а сам набор идет последним. Набор самый
# дорогой из гейтов, и узнать, что ему не на чем бежать, надо за секунду, а не
# после двадцати минут остальных. Скрипт ничего не поднимает: при отказе он
# называет команду, которая готовит стенд (dm.ps1 e2e или dm.sh e2e выключают
# лимит запросов так же, как оверлей джобы e2e в CI).
if wants e2e && e2e_requested; then
  say "e2e: стенд"
  bash "$ROOT/scripts/check-e2e-stand.sh"
elif wants e2e; then
  say "e2e: на ветке его гонит CI на PR, здесь только с DM_GATES_FULL=1"
fi

# Джоба compose-topology целиком. Всей ей нужен только docker, и вся она идет
# двадцать две секунды, поэтому оставлять тут ее дешевую часть смысла нет:
# правка файлов развертывания все равно красила бы пуш на той половине, что
# осталась в CI. Так и прятался разбор скриптов: цикл по одному элементу в
# scripts/verify-seed-reproducibility.sh уехал в origin и остановил джобу, от
# которой зависит вся публикация.
if wants compose-topology; then
  say "Скрипты оболочки: shellcheck"
  bash "$ROOT/scripts/check-shell-scripts.sh"

  say "Развертывание: топология compose"
  bash "$ROOT/scripts/deployment/check-compose-topology.sh"

  say "Развертывание: конфигурации nginx"
  bash "$ROOT/scripts/deployment/check-nginx-configuration.sh"

  say "Развертывание: установщик сервера"
  bash "$ROOT/scripts/deployment/check-server-installer.sh"

  say "Развертывание: мониторинг"
  bash "$ROOT/scripts/deployment/check-monitoring.sh"
fi

# npm ci, а не npm install: CI ставит пакеты только так, и эта форма падает,
# когда package-lock.json разошелся с package.json. Гейты ниже гоняются по уже
# разложенному node_modules и рассинхрона не видят вовсе — им все равно, чем и
# когда он был разложен. --dry-run ничего не ставит и не трогает дерево:
# проверяется ровно то, из-за чего CI отверг lock-файл.
if wants frontend; then
  say "Фронтенд: синхронность lock-файла"
  (cd "$CLIENT" && npm ci --dry-run)

  say "Фронтенд: линт"
  (cd "$CLIENT" && npm run lint:ci)

  say "Фронтенд: типы"
  (cd "$CLIENT" && npm run type-check)
fi

# Юнит-тесты клиента читают документы: имена файлов в комментариях проверяются
# по дереву, BBCODE_RENDERING.md и UI_STANDARDS.md разбираются как данные.
# Поэтому они идут и тогда, когда пуш правит одни документы (джоба docs).
if wants frontend || wants docs; then
  say "Фронтенд: юнит-тесты"
# Через npm run test:coverage, а не npx vitest run: пороги покрытия объявлены в
# блоке coverage.thresholds (vite.config.ts) и применяются только при --coverage.
# Голой командой хук гонял те же тесты и не проверял тот же порог.
  (cd "$CLIENT" && npm run test:coverage)
fi

if wants frontend; then
  say "Фронтенд: сборка"
  (cd "$CLIENT" && npm run build)
fi

# Джоба dependency-scan стоит в needs у обеих джоб публикации, поэтому ее
# падение останавливает выкладку целиком, а уязвимые пакеты в истории проекта
# доезжали до origin дважды. npm ci, в отличие от CI, тут не нужен: на клоне
# node_modules уже стоят, а audit читает package-lock.json.
if wants dependency-scan; then
  say "Зависимости: пакеты npm"
  (cd "$CLIENT" && npm audit --omit=dev --audit-level=high)

  say "Зависимости: пакеты .NET"
  bash "$ROOT/scripts/check-vulnerable-packages.sh"
fi

# Джоба docs: архитектурные тесты без остального решения. Карта зовет ее только
# тогда, когда build не нужен, а build гоняет эти же тесты в составе решения.
if wants docs; then
  say "Документы: архитектурные тесты Release"
  dotnet test "$ROOT/test/DM.Architecture.Tests" -c Release --nologo
fi

if wants build; then
  say "Бэкенд: форматирование"
  dotnet format "$ROOT/DM.sln" whitespace --verify-no-changes

  say "Бэкенд: сборка Release"
  dotnet build "$ROOT/DM.sln" -c Release --nologo -v q

  # Интеграционные тесты поднимают Testcontainers: нужен docker. Если демон не
  # отвечает, это не повод пропустить гейт молча.
  #
  # --no-build: решение собрано строкой выше. С -c Debug, который стоял здесь
  # раньше, хук компилировал решение второй раз и проверял не те бинари, что
  # прошли гейт сборки.
  #
  # Покрытие собирается этим же прогоном — так его получает CI: шаг Test в
  # .github/workflows/dotnet.yml пишет по отчету cobertura на тестовый проект в
  # --results-directory, а шаг Coverage threshold читает оттуда же. Каталог
  # отдается пустым: у CI чекаут чистый, а тут TestResults копится прогонами, и
  # отчет, слитый из нескольких состояний кода, не описывает ни одно из них.
  say "Бэкенд: тесты Release"
  rm -rf "$ROOT/TestResults"
  dotnet test "$ROOT/DM.sln" --no-build -c Release --nologo --results-directory "$ROOT/TestResults" --collect:"XPlat Code Coverage"

  # Порог покрытия решения. Стоял только в CI, и это ровно тот случай, ради
  # которого хук существует: узнать о падении на двадцатой минуте прогона, уже
  # после пуша.
  say "Бэкенд: покрытие"
  bash "$ROOT/scripts/check-coverage.sh"
fi

# Тот же test:e2e:fast, что зовет джоба e2e: один профиль браузера, весь набор.
# Бандл конфиг собирает и поднимает сам, от стенда нужен только API. Открывать
# отчет HTML запрещено явно: после падения Playwright открывает его, когда видит
# терминал, и прогон стоит на сервере отчета до Ctrl+C.
#
# CI=1 дает набору те же настройки, что в джобе e2e: playwright.config.ts
# включает по этой переменной один воркер, два повтора и запрет test.only. Без
# нее набор шел параллельно и без повторов, то есть не тем прогоном, который
# проходит или падает в CI. Общий таймаут стоит вместо timeout-minutes джобы:
# тест, повисший на закрытии браузера, иначе держал бы пуш без конца.
#
# Код возврата у набора честный. Строка "1 did not run" в итоге значит тест из
# группы, чей beforeAll упал: сам он не запускался, а падение хука засчитано
# тесту, в котором хук выполнялся, и стоит в строке "N failed" выше по выводу.
if wants e2e && e2e_requested; then
  say "e2e: набор на одном профиле"
  (cd "$CLIENT" && CI=1 PLAYWRIGHT_HTML_OPEN=never npm run test:e2e:fast -- --global-timeout=1800000)
fi

say "Все нужные гейты зеленые"
