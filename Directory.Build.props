<Project>
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- There is deliberately no WarningsNotAsErrors list. It used to exempt ten
             nullable codes "for gradual adoption"; a Rebuild of the whole solution in
             Release produces zero warnings, so the list bought nothing and only left a
             hole through which a codebase that already reached nullable compliance
             could silently regress out of it. -->
        <Nullable>enable</Nullable>
        <!-- Vulnerability warnings are silenced at build time, not ignored. The
             SDK does offer per-advisory suppression these days (NuGetAuditSuppress,
             since NuGet 6.11), but adopting it would put a second copy of the
             reviewed-advisory list into MSBuild next to the one the dependency-scan
             job already enforces through .github/vulnerability-allowlist.txt — and
             two sources of truth is the exact failure this comment used to justify
             by SDK limitation. One enforcement point, on purpose: the scan job
             fails on anything outside the allowlist. -->
        <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
        <!-- CS8524 is the half of switch-expression exhaustiveness that cannot be
             satisfied. It fires on the cast of an undeclared integer, so a switch
             covering every member of an enum still warns, and under
             TreatWarningsAsErrors the only way to compile one was a `_ =>` arm.
             That arm also swallows CS8509 — the half that matters, the one that
             names the member nobody handled — so a member added to a domain enum
             reached the client as a null reason instead of stopping the build.
             Silencing CS8524 once, here, is what lets those arms go. CS8509 is
             deliberately not silenced. -->
        <NoWarn>$(NoWarn);CS8524</NoWarn>
        <!-- CS1591 required an XML comment on every public member. A build can require
             that the text exist and cannot require that it mean anything, so what the
             rule produced was <inheritdoc /> on constructors, where the tag inherits
             nothing because a constructor has no base member to inherit from, and
             one-line summaries restating the name of the member below them. The cost
             is not neutral: a reader who opens enough empty comments stops opening the
             ones that are not empty. The only generated XML that anything reads is
             DM.Web.API.xml, which Swagger loads into the API document, and that project
             had silenced the diagnostic for itself long ago, so the requirement pressed
             hardest exactly where the output is never opened. That local silencing goes
             with this line, and so does the per-folder exemption the persistence
             entities carried: a folder cannot be exempt from a diagnostic the solution
             no longer raises. What an endpoint owes its readers is enforced elsewhere
             and is untouched: an architecture gate matches the response codes an action
             declares by attribute against the ones its doc comment describes, and fails
             when either side is missing. The comments already written stay where they
             are; removing them is a separate pass, and nothing demands the next one. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- Pinned, not "preview". The accepted language used to be whatever SDK
             happened to be installed: CI pins 10.0.x and the images use sdk:10.0, so a
             developer on a newer SDK could write a feature that compiles locally and
             fails in CI with an error that names no cause. 14.0 is the language of
             net10.0; a Rebuild of the whole solution in Release is clean under it. -->
        <LangVersion>14.0</LangVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>$(AssemblyName).Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>