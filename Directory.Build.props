<Project>
    <PropertyGroup>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- No WarningsNotAsErrors list: the solution builds with zero warnings, and a list
             would leave a hole for nullable regressions. -->
        <Nullable>enable</Nullable>
        <!-- Vulnerability warnings are silenced here because the dependency-scan job already
             fails on anything outside .github/vulnerability-allowlist.txt, the single list. -->
        <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
        <!-- CS8524 fires on the cast of an undeclared integer, which forced a `_ =>` arm that
             also swallowed CS8509, the warning that names an unhandled enum member. -->
        <NoWarn>$(NoWarn);CS8524</NoWarn>
        <!-- CS1591 forced empty summaries and <inheritdoc /> on constructors. The response
             codes of an action are checked against its doc comment by an architecture test. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <!-- CS1573 asked for a param tag on every parameter once one had a tag, so a doc that
             explains one parameter retold the others by their names. -->
        <NoWarn>$(NoWarn);CS1573</NoWarn>
        <!-- Pinned, not "preview": a newer local SDK would accept features CI rejects. -->
        <LangVersion>14.0</LangVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <!-- Runs the IDE rules of .editorconfig in the command-line build (IDE0005 also needs
             GenerateDocumentationFile above). -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>$(AssemblyName).Tests</_Parameter1>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>
</Project>