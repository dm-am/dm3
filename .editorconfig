root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# C# files
[*.cs]
indent_size = 4

# CA2254: an interpolated logging template inlines the value into the message, so a
# secret spelled there cannot be taken back and the property is lost to queries.
dotnet_diagnostic.CA2254.severity = error

# Mapperly replaces AutoMapper's AssertConfigurationIsValid at compile time:
# RMG012/RMG020 are its two halves, RMG068 catches projections that fall back to
# client evaluation and N+1.
dotnet_diagnostic.RMG012.severity = error
dotnet_diagnostic.RMG020.severity = error
dotnet_diagnostic.RMG068.severity = error

# RMG090: a nullable mapping into a non-nullable target throws at runtime and 500s the
# whole response. RMG089 is not raised yet: its findings are contract decisions of their own.
dotnet_diagnostic.RMG090.severity = error

# Dead code is a build error (the IDE rules reach the command-line build through
# EnforceCodeStyleInBuild). Parameters and static candidates are checked on the
# non-public surface only: a public action parameter also binds the request.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.CA1822.severity = warning
dotnet_code_quality_unused_parameters = non_public
dotnet_code_quality.CA1822.api_surface = private, internal

# Test sources
[test/**.cs]
# xUnit1051 fires on nearly every call that takes a CancellationToken and a test run sets no
# deadline, so the rewrite buys little. A suggestion, not off: the editor still offers the fix.
dotnet_diagnostic.xUnit1051.severity = suggestion

# Mapperly inlines this configuration method into the projection and never calls it,
# so IDE0051 reads it as unused while deleting it breaks the projection.
[src/DM.Infrastructure.Persistence/Repositories/Community/AchievementMapper.cs]
dotnet_diagnostic.IDE0051.severity = none

# Solution files
[*.sln]
indent_style = tab

# XML project files
[*.{csproj,props,targets}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false

# Vue/TypeScript files
[*.{vue,ts,tsx,js,jsx}]
indent_size = 2

# SASS/CSS files
[*.{sass,scss,css}]
indent_size = 2
