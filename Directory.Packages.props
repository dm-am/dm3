<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive pinning lets a PackageVersion entry raise a dependency we do
         not reference directly. Without it the only way to patch a vulnerable
         transitive package is to add a fake direct reference to it. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="AWSSDK.S3" Version="3.7.400.5" />
    <!-- Ed25519 for the Discord interactions signature: the BCL (through .NET 10)
         has no Ed25519, and the algorithm is fixed by Discord, not chosen here. -->
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="FluentValidation" Version="11.9.2" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="MimeKit" Version="4.17.0" />
    <!-- Same-version guards: both resolve to exactly this from the graph today;
         the entries exist so no other branch of the graph can ever drag them
         below it. Re-check on major platform moves, not routinely. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="System.Text.Json" Version="10.0.11" />
    <!-- Pinned transitives: each carries a published advisory at the version the
         dependency graph would otherwise resolve to. -->
    <PackageVersion Include="SharpCompress" Version="0.50.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="AspNetCore.HealthChecks.Npgsql" Version="9.0.0" />
    <!-- 9.0.0 is the major built for RabbitMQ.Client 7.x: the check takes the
         connection asynchronously instead of building one from a factory of its
         own, so the probe answers about the connection the application publishes
         on rather than about a parallel one. -->
    <PackageVersion Include="AspNetCore.HealthChecks.Rabbitmq" Version="9.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The mocking library, replacing Moq 4.20 (last release 09.2024, and the
         4.20.0 SponsorLink incident is what ended trust in the line). Its
         analyzer package is the only guard against NSubstitute's silent failure
         mode - a misplaced Received() or a substitute call outside a When()
         block compiles and passes - so it travels with the library and never
         ships as a runtime dependency. -->
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <!-- Преемник заброшенного OpenTelemetry.Contrib.Instrumentation.EntityFrameworkCore
         (тот поставлял только netstandard2.0 и зависел от OpenTelemetry.Api 1.0.1).
         Переход выполнен вместе с поднятием ядра, как и было решено 2026-08-12.
         Стабильной версии у пакета не существует - он бета у самого проекта
         OpenTelemetry и обещает ломающие изменения между бетами, поэтому версия
         держится строго в полосе ядра и едет только вместе с ним. -->
    <PackageVersion Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.18.0-beta.1" />
    <!-- RFC 6238 arithmetic and Base32, neither of which the BCL carries. MIT,
         released 12.2025, seventeen contributors, no move towards a commercial
         licence. Taken for two things only: the encoding a authenticator app
         expects, and the time step a code matched on - without that number the
         replay guard of the second factor has nothing to remember. Everything
         else about the factor is ours. -->
    <PackageVersion Include="Otp.NET" Version="1.4.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <!-- Стабильной версии у этого экспортера не существует: он остается бетой у
         самого проекта OpenTelemetry, и предрелизность тут не отставание. Ядро
         вниз не тянет — зависимость объявлена диапазоном [1.10.0, 2.0.0), и в
         графе разрешается версия соседних строк. Между бетами менялось поведение
         суффикса _total и формата OpenMetrics, то есть поднятие в одиночку
         переименует серии, на которые уже написаны правила и панели. Решено
         2026-08-13 поднимать только вместе со следующим поднятием ядра. -->
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.18.0-beta.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="Polly" Version="8.4.1" />
    <!-- The official client, replacing the Jamq wrapper (bus-factor 1, pinned to
         the EOL 6.x client, basic.qos global=true - a broker 4.x blocker). The
         thin layer over it is our own DM.Infrastructure.Messaging. -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <!-- Compile-time mapping generator replacing AutoMapper 13 (frozen MIT
         branch; 15.0 went commercial). Source-generator only: every reference
         carries PrivateAssets="all" so the analyzer never ships as a runtime
         dependency. -->
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Grafana.Loki" Version="9.0.1" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore.Swagger" Version="10.2.3" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
    <!-- Не Testcontainers тянет ее сюда по своей воле: он объявляет нижнюю
         границу 2025.1.0, а весь диапазон до нее включительно закрыт советом
         GHSA-q939-rpr3-3284 (ScpClient пишет туда, куда скажет сервер, при
         рекурсивной загрузке). Патч вышел в 2026.0.0, апстрим на него не
         перешел даже в 4.13.0. Поднимается транзитивным пиннингом
         сверху: граница у зависимости нижняя, поэтому 2026.0.0 ее
         удовлетворяет, а не нарушает. Снять, когда Testcontainers потребует
         2026.0.0 сам. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.3.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.3.0" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.3" />
    <!-- The xUnit assertion adapter comes in one package per xUnit major: the
         .xUnit one is compiled against xunit.abstractions and stops resolving the
         moment the suite is on v3. Held at the same version as the core package
         above, which it depends on by exact-or-higher bound. -->
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.3" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <!-- xunit.v3, not xunit: v3 renamed the package, so the v2 id will never see
         another release. Deliberately the 3.2.x line and not 4.0.0, which landed
         in August 2026 on Microsoft.Testing.Platform v2: the CI test step collects
         coverage through the VSTest data collector, the "XPlat Code Coverage"
         collect switch plus coverlet.collector, and that path is what the 3.x
         runner keeps. Moving to 4.0.0 is a runner migration on top of a framework
         migration and belongs in its own pass. -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>