# === Секреты (на production заменить) ===
# Для CI и локальной работы дефолты безопасные. В паролях нет символов, которые в URI
# пришлось бы экранировать: пароль экспортера подставляется в scheme://user:PASS@host, и
# "@" обрывает такую строку. Допустимы буквы, цифры и знаки - . _ ~ ! $ & ' ( ) * + , ; =
POSTGRES_PASSWORD=TestPass123!
# Роль приложения и роль экспортера; суперпользователь выше нужен только для инициализации тома.
DM_APP_PASSWORD=TestPass123!
DM_EXPORTER_PASSWORD=TestPass123!
GF_SECURITY_ADMIN_PASSWORD=TestPass123!

# === Объектное хранилище (SeaweedFS) ===
# Администратора нет: бакет создает сам сервер, две учетки и публичное чтение аватаров
# задает файл, который docker/storage-start.sh собирает из этих значений на каждом
# старте. Пароль меняется правкой здесь и docker compose up -d. Нельзя двойную и
# одинарную кавычку, обратную косую черту и управляющие символы. На production значения
# генерирует docker/scripts/init-env.sh server.
STORAGE_APP_USER=dm-app
STORAGE_APP_PASSWORD=TestPass123!
STORAGE_BACKUP_USER=dm-backup
STORAGE_BACKUP_PASSWORD=TestPass123!
# Имя бакета после установки не меняется: на томе со старым бакетом новое имя создает
# второй, пустой, а проверки остаются зелеными. Край знает имя текстом, в
# nginx/edge-locations.conf и nginx/pop.conf.template.
# STORAGE_BUCKET=dm-uploads

# === Версия образов ===
# Один тег на все четыре образа: их собирает один прогон CI. latest публикуется только с
# main, имя ветки с ветки, короткий sha с каждого прогона. Для клона и точки присутствия:
# на сервере релиз называет образы дайджестами, откат там dm3-release rollback.
# Локальной разработки не касается.
# IMAGE_TAG=latest

# === Выпуск на сервере (читает скрипт выпуска, не compose) ===
# init-env.sh server ставит оба значения, только если они пусты. Режим схемы reset или
# migrate, без ключа reset. Запас памяти в МиБ, который выпуск оставляет свободным.
# DM_SCHEMA_REGIME=reset
# DM_RELEASE_HEADROOM_MIB=512

# === Криптография (ОБЯЗАТЕЛЬНО, один ключ на экземпляр приложения) ===
# Шифрует токен сессии и одноразовые ссылки из писем. Дефолта нет намеренно: ключ,
# унаследованный из исходников, позволяет подделать сессию. Точке присутствия ключ не нужен.
# Пустое значение не проходит, compose останавливается на интерполяции. Сгенерировать:
#   openssl rand -base64 32
# CI заводит ключ тем же docker/scripts/init-env.sh local.
DM_CryptoConfiguration__KeyBase64=

# === Хосты сервисов (дефолты для локальной разработки) ===
# DB_HOST=dm-pg
# STORAGE_HOST=dm-storage
# MAIL_HOST=dm-mailpit
# MAIL_PORT=1025
# Логин и пароль на relay писем сайта. Пусто: отправка без входа, как у Mailpit стенда.
# У алертов вход свой, ALERT_SMTP_USERNAME и ALERT_SMTP_PASSWORD ниже.
# MAIL_USERNAME=
# MAIL_PASSWORD=
# Требовать шифрование к relay. На стенде выключено: Mailpit предлагает STARTTLS только
# с сертификатом. На сервере с настоящим relay включать, в письмах ездят ссылки
# активации и сброса пароля.
# MAIL_REQUIRE_TLS=false
# LOGS_HOST=dm-victorialogs
# TRACING_HOST=dm-jaeger

# === URLs (дефолты для локальной разработки) ===
# Отдельного адреса у API нет: сайт и API отвечают на одном origin. Список источников,
# с которых браузеру разрешено звать API, выводится из этих адресов.
# WEB_URL=http://localhost:5173
# CDN_PUBLIC_URL=http://localhost:9000

# === Доставка алертов ===
# Правила Prometheus (docker/prometheus/alerts.yml) уходят в alertmanager, а он шлет их
# почтой через тот же relay, что и письма приложения (MAIL_HOST, MAIL_PORT). На стенде это
# Mailpit, срабатывание видно на http://localhost:8025. Логин и пароль нужны только relay,
# который их спрашивает.
# ALERT_EMAIL_TO=alerts@dm.am
# ALERT_EMAIL_FROM=alertmanager@dm.am
# ALERT_SMTP_USERNAME=
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_REQUIRE_TLS=false

# === Общий вход между адресами ===
# Пусто: вход на каждом адресе свой. Регистрируемый домен делает сессию общей для всех его
# хостов; включать только когда все они наши.
# SESSION_COOKIE_DOMAIN=dm.am

# === Боты уведомлений (опционально) ===
# Токены Telegram и Discord, секрет вебхука Telegram и Public Key Discord. Пусто: вебхук
# закрыт (404), отправка через бота выключена. Регистрация: docs/references/CONFIGURATION.md.
# DM_BotConfiguration__TelegramBotToken=
# DM_BotConfiguration__TelegramWebhookSecret=
# DM_BotConfiguration__DiscordBotToken=
# DM_BotConfiguration__DiscordPublicKey=

# === Точка присутствия ===
# Заполняются только в .env.pop, секретов там нет (docs/guides/POINT_OF_PRESENCE.md).
# POP_UPSTREAM=https://dm.am
# POP_UPSTREAM_HOST=dm.am

# === SSL для удаленных БД ===
# DB_SSL_MODE=;SSL Mode=Require

# === Off-site backup (optional) ===
# S3_BACKUP_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1

# Local development. Unset on a server: docker-compose defaults to Production,
# which keeps the dev-only seed and role endpoints closed.
ASPNETCORE_ENVIRONMENT=Development

# Log level, both sinks at once. Unset means Debug in Development and Information
# elsewhere. Set to Debug for the length of an incident and unset it after: this
# is the knob for that, not ASPNETCORE_ENVIRONMENT, which also publishes Swagger
# and drops HSTS. Takes effect on restart; a value Serilog does not know stops
# the start rather than silently keeping the default.
# LOG_MINIMUM_LEVEL=Debug
