# === Секреты (ОБЯЗАТЕЛЬНО изменить!) ===
POSTGRES_PASSWORD=changeme_postgres
RABBITMQ_DEFAULT_PASS=changeme_rabbit
MINIO_ROOT_PASSWORD=changeme_minio
GF_SECURITY_ADMIN_PASSWORD=changeme_grafana

# === Версия образа ===
# По умолчанию: ghcr.io/dm-am/dm-api:latest
# Для локальной разработки с build: можно не указывать
# API_IMAGE=dm-api:local

# === Криптография (КРИТИЧНО: одинаковый на ВСЕХ серверах!) ===
# Генерация: openssl rand -base64 32
# Для локальной разработки: используется дефолт из appsettings.json
# Для production: раскомментировать и задать
# DM_CryptoConfiguration__KeyBase64=your-production-key-here

# === Хосты сервисов (дефолты для локальной разработки) ===
# DB_HOST=dm-pg
# MONGO_HOST=dm-mongo
# RABBITMQ_HOST=dm-rmq
# SEARCH_HOST=dm-es
# SEARCH_GRPC_HOST=dm-search-engine-consumer
# MINIO_HOST=dm-minio
# MAIL_HOST=dm-mailhog
# LOGS_HOST=dm-es
# TRACING_HOST=dm-jaeger

# === URLs (дефолты для локальной разработки) ===
# WEB_URL=http://localhost:5000
# API_URL=http://localhost:5000
# CDN_PUBLIC_URL=http://localhost:9000
# CORS_URL_0=http://localhost:5173
# CORS_URL_1=http://localhost:8080

# === Зеркало ===
# MIRROR_ID=main

# === SSL для удалённых БД ===
# DB_SSL_MODE=;SSL Mode=Require
# MONGO_TLS=&tls=true

# === Off-site backup (optional) ===
# S3_BACKUP_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1
