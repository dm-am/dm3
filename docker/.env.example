# === Секреты (ОБЯЗАТЕЛЬНО изменить на production!) ===
# Для CI и локальной работы используются безопасные дефолты.
#
# Пароли не содержат символов, которые в URI пришлось бы экранировать. Два из
# них подставляются внутрь строки подключения вида scheme://user:PASS@host:
# Mongo у API и postgresql у экспортера метрик. Символ "@" в значении обрывает
# такую строку на первом же вхождении, и API не стартует вообще: строка
# подключения признается невалидной до первого запроса. Допустимы буквы, цифры
# и знаки - . _ ~ ! $ & ' ( ) * + , ; =
POSTGRES_PASSWORD=TestPass123!
RABBITMQ_DEFAULT_PASS=TestPass123!
MINIO_ROOT_PASSWORD=TestPass123!
GF_SECURITY_ADMIN_PASSWORD=TestPass123!

# === MongoDB ===
# Аутентификация включена: в этом хранилище лежат сессии, журнал безопасности и
# попытки входа. Root-аккаунт нужен только для bootstrap и health check,
# приложение ходит под MONGO_USER с readWrite на базе dm3.
# Пользователь создается initdb-хуком, а он срабатывает только на пустом томе:
# смена этих значений на существующем томе требует пересоздания тома.
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=TestPass123!
MONGO_USER=dm
MONGO_PASSWORD=TestPass123!

# === MinIO ===
# Рут нужен только для bootstrap: под ним minio-init создает бакет и два
# аккаунта с политикой на один этот бакет. Приложение пишет и удаляет объекты,
# imgproxy только читает. Под рутом не ходит никто, кроме скрипта бэкапа.
# На production значения генерировать заново, например openssl rand -base64 24.
MINIO_APP_USER=dm-app
MINIO_APP_PASSWORD=TestPass123!
MINIO_IMGPROXY_USER=dm-imgproxy
MINIO_IMGPROXY_PASSWORD=TestPass123!

# === imgproxy URL signing (HMAC-SHA256) ===
# 64 hex chars каждое (= 32 bytes). На production генерировать новые:
#   openssl rand -hex 32
IMGPROXY_KEY=943b421c0089cdf87d15bd24210d8df80abf7e8aa3a4f96f5c4f7d5e0c8b6a93
IMGPROXY_SALT=520f986bbb1d7c4f9e1a6c83b5d0f4789e123456789abcdef0123456789abcde

# === Версия образов ===
# Один тег на все четыре образа (api, worker-mail, worker-notification, front):
# их собирает один прогон CI из одного коммита, и разносить их по разным тегам
# нечем. latest публикуется только с main, имя ветки - с ветки, короткий sha - с
# каждого прогона. Откат стенда: поставить sha предыдущего прогона и
# перезапустить dm3.service.
# Локальной разработки это не касается: docker compose build кладет образ под
# тем же именем, и up берет локальный.
# IMAGE_TAG=latest

# === Криптография (ОБЯЗАТЕЛЬНО, один на все экземпляры приложения) ===
# Этим ключом шифруются токен сессии и одноразовые ссылки из писем. Экземпляр
# приложения один: точке присутствия ключ не нужен и на ней его быть не должно. Дефолта в
# репозитории нет намеренно: развертывание, унаследовавшее ключ из исходников,
# не имеет секрета вовсе - подделать сессию сможет любой, кто прочитал код.
# Единственная переменная файла, у которой значение не может быть примером.
#
# Пустая строка не проходит: в docker-compose.yml переменная объявлена через
# ${...:?}, и compose останавливается на интерполяции - до старта приложения,
# до сборки образов, до всего. То есть "cp .env.example .env" - это половина
# первого запуска, вторая половина здесь:
#   openssl rand -base64 32
#
# CI ключ сюда не пишет: воркфлоу отдает разовое значение через окружение,
# которое у compose приоритетнее .env, и стек умирает вместе с прогоном.
DM_CryptoConfiguration__KeyBase64=

# === Хосты сервисов (дефолты для локальной разработки) ===
# DB_HOST=dm-pg
# MONGO_HOST=dm-mongo
# RABBITMQ_HOST=dm-rmq
# MINIO_HOST=dm-minio
# MAIL_HOST=dm-mailhog
# MAIL_PORT=1025
# LOGS_HOST=dm-loki
# TRACING_HOST=dm-jaeger

# === URLs (дефолты для локальной разработки) ===
# Отдельного адреса у API нет: сайт и его API отвечают на одном origin, клиент
# просит /v1 относительно того адреса, с которого загрузился.
# WEB_URL=http://localhost:5000
# CDN_PUBLIC_URL=http://localhost:9000
# IMGPROXY_PUBLIC_URL=http://localhost:8080
# CORS_URL_0=http://localhost:5173

# === Доставка алертов ===
# Правила Prometheus (docker/prometheus/alerts.yml) уходят в alertmanager, а он
# отправляет их почтой по тому же тракту, что и письма приложения: адрес relay
# берется из MAIL_HOST и MAIL_PORT выше, отдельного секрета у алертов нет.
# На стенде это MailHog, и срабатывание видно на http://localhost:8025.
# Логин и пароль нужны только relay, который их спрашивает; пустые значения
# означают отправку без аутентификации.
# ALERT_EMAIL_TO=alerts@dm.am
# ALERT_EMAIL_FROM=alertmanager@dm.am
# ALERT_SMTP_USERNAME=
# ALERT_SMTP_PASSWORD=
# ALERT_SMTP_REQUIRE_TLS=false

# === Общий вход между адресами ===
# Пусто — вход на каждом адресе свой. Значение регистрируемого домена делает
# сессию общей для всех его хостов. Включать только когда каждый хост этого
# домена обслуживается нами.
# SESSION_COOKIE_DOMAIN=dm.am

# === Точка присутствия ===
# Заполняются только в .env.mirror, на машине точки присутствия. Секретов тут нет и
# быть не должно: точка присутствия не выполняет кода приложения, она отдает фронтенд со
# своего диска и передает запросы к API на основной сервер.
# POP_UPSTREAM=https://dm.am
# POP_UPSTREAM_HOST=dm.am

# === SSL для удаленных БД ===
# DB_SSL_MODE=;SSL Mode=Require
# MONGO_TLS=&tls=true

# === Off-site backup (optional) ===
# S3_BACKUP_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-central-1

# Local development. Unset on a server: docker-compose defaults to Production,
# which keeps the dev-only seed and role endpoints closed.
ASPNETCORE_ENVIRONMENT=Development
