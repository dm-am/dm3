# === Окружение точки присутствия ===
#
# Копируется в .env.mirror. Команда запуска - docs/guides/MIRRORING.md.
#
# Точка присутствия не выполняет код приложения и не подключается ни к одному
# хранилищу: она отдает фронтенд со своего диска и передает наверх запросы к API
# основного сервера. Поэтому здесь нет ни одного настоящего секрета, и копировать
# сюда .env.example нельзя - тот везет пароли Postgres, Mongo, MinIO, RabbitMQ и
# Grafana из репозитория на машину, которой они не нужны.

# === Заполнить ===
# Пустые значения не проходят: обе объявлены через ${...:?}, и compose
# останавливается на интерполяции, назвав недостающую переменную.
POP_UPSTREAM=
POP_UPSTREAM_HOST=

# === Край ===
# Каталог с fullchain.pem и privkey.pem, которые выдал certbot. TLS обязателен:
# основной сайт отдает HSTS с includeSubDomains, и браузер постоянного посетителя
# сам перепишет http-адрес точки присутствия в https.
POP_SSL_DIR=./nginx/ssl

# === Версия образа фронтенда ===
# Сборка интерфейса на точке присутствия обязана совпадать с той, что отдает
# основной адрес. Пусто - latest.
IMAGE_TAG=

# === Заглушки ===
# Ниже - переменные, которые требует базовый compose-файл: команда называет его,
# потому что nginx и dmfront описаны как оверлей над ним, а якорь x-workload-env
# разбирается при чтении файла, а не при подъеме сервиса. Ни один сервис,
# который поднимает точка присутствия, их не читает.
#
# Значения намеренно не похожи на ключи: если такое значение куда-то доедет,
# это видно с первого взгляда, а настоящий секрет на этой машине выглядел бы
# рабочим и молчал.
DM_CryptoConfiguration__KeyBase64=not-used-on-a-point-of-presence
MONGO_ROOT_PASSWORD=not-used-on-a-point-of-presence
MONGO_PASSWORD=not-used-on-a-point-of-presence
MINIO_APP_PASSWORD=not-used-on-a-point-of-presence
MINIO_IMGPROXY_PASSWORD=not-used-on-a-point-of-presence
