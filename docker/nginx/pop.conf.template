# Point of presence edge. A file apart from nginx.conf because the job differs: that edge
# stands beside the application and serves its docker network neighbours, while this door
# sits in another network, holds no application and reaches it by its external address, so
# it has an external upstream and a cache.
#
# Substituted by the envsubst of the nginx image at start; only POP_ variables are replaced
# (NGINX_ENVSUBST_FILTER), so the $host and $scheme of nginx survive.
#   POP_UPSTREAM       origin of the main server, for example https://dm.am
#   POP_UPSTREAM_HOST  name set in Host and SNI, for example dm.am
#
# TLS is mandatory: docs/guides/POINT_OF_PRESENCE.md, "Требования к машине".

proxy_cache_path /var/cache/nginx/media levels=1:2 keys_zone=pop_media:16m
                 max_size=2g inactive=30d use_temp_path=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    # Health of the point of presence itself, nothing about the application beyond the
    # border. On http because docker asks it from inside the container.
    location = /pop-health {
        access_log off;
        # default_type, not add_header: a return with a body already sets Content-Type, and
        # add_header would append a second.
        default_type text/plain;
        return 200 "ok\n";
    }

    # Certificate authority challenge: anonymous, so it precedes the redirect. ^~ beats
    # location /, or the check goes to https, which does not exist at the first issue.
    location ^~ /.well-known/acme-challenge/ {
        access_log off;
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/live/dm/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/live/dm/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:pop_ssl:10m;
    ssl_session_timeout 1d;

    # The same limit as the main edge, or the point of presence passes a file that the main
    # server returns as an HTML 413 instead of an API error.
    client_max_body_size 10m;

    # The door is the second public edge and sets its own policy headers: the shared
    # nginx.conf is not mounted here, and the SPA expects the edge to set them.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # The same four arrive from above (the application, then the main edge), and add_header
    # appends instead of replacing, so a response would carry two values of one policy.
    # Hidden exactly where set here. Content-Security-Policy is set by nobody here and passes
    # through.
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header Permissions-Policy;

    # Frontend from the local disk: the SPA container runs beside, which is half the point.
    location / {
        proxy_pass http://dmfront:80;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Application requests go across the border. Host and SNI are the main server's name: the
    # certificate is issued for it and the application recognises itself by it.
    # X-Forwarded-Proto carries the scheme of the VISITOR, not of this hop upward: the
    # application decides on the Secure cookie by it.
    #
    # Liveness and readiness by exact match, as on the main edge: otherwise they fall into
    # location /, the SPA answers 200 to any path, and an external heartbeat reports a healthy
    # site as long as the edge lives. Not a prefix, which would publish /_health/detail.
    location = /_health {
        access_log off;
        proxy_pass ${POP_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_ssl_name ${POP_UPSTREAM_HOST};
        proxy_set_header Host ${POP_UPSTREAM_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /_ready {
        access_log off;
        proxy_pass ${POP_UPSTREAM};
        proxy_ssl_server_name on;
        proxy_ssl_name ${POP_UPSTREAM_HOST};
        proxy_set_header Host ${POP_UPSTREAM_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Liveness of the edge itself, over https too: on 80 everything else redirects, so over
    # http only docker sees this probe.
    location = /pop-health {
        access_log off;
        default_type text/plain;
        return 200 "ok
";
    }

    location /v1/ {
        proxy_pass ${POP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${POP_UPSTREAM_HOST};
        proxy_set_header Host ${POP_UPSTREAM_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }

    # Live updates: the same headers plus the connection upgrade, or the websocket does not
    # come up and the client falls back to long polling. The hub is mapped at /hubs/.
    location /hubs/ {
        proxy_pass ${POP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${POP_UPSTREAM_HOST};
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host ${POP_UPSTREAM_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Uploads and their thumbnails: the same proxying plus a cache. Content is public and immutable by
    # address, so it keeps long. The cookie does not go upstream: the cache key ignores it, and
    # while the request is anonymous the "same for everyone" property belongs to this config.
    # The policy headers are repeated because add_header in a location cancels the inheritance
    # from the server; proxy_hide_header inherits by the same rule, so the server's hides
    # apply and strip the incoming copies before these four are added.
    location ~ ^/dm-uploads/ {
        proxy_pass ${POP_UPSTREAM};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name ${POP_UPSTREAM_HOST};
        proxy_set_header Host ${POP_UPSTREAM_HOST};
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Cookie "";

        proxy_cache pop_media;
        proxy_cache_valid 200 206 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_revalidate on;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }
}
