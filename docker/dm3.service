[Unit]
Description=DM3 (the release rel/current names)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The release script holds the one compose command line, so a reboot starts what rel/current
# names from its own definitions and puts the edge back on the primaries, as recovery does.
# Both wait for the lock of a run in progress.
ExecStart=/usr/local/sbin/dm3-release boot
ExecStop=/usr/local/sbin/dm3-release stop
# A first start pulls nothing, but recovery waits for the API to be ready behind the edge.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
