[Unit]
Description=DM3 Application (Docker Compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/dm3/docker
# The same overlay and profile the installer deployed with: without the overlay a restart
# replaces the site with a bare API (no nginx, no frontend), and without the profile
# watchtower stops updating after the first reboot. CI compares both lines with
# setup-server.sh.
ExecStart=/usr/bin/docker compose --profile production -f docker-compose.yml -f docker-compose.preview.yml up -d
ExecStop=/usr/bin/docker compose --profile production -f docker-compose.yml -f docker-compose.preview.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
