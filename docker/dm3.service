[Unit]
Description=DM3 Application (Docker Compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/dm3/docker
# The same overlay the installer deployed with. Without it systemd brought up
# the base topology - no nginx, no frontend - while ExecStop tore down every
# container of the project, so a restart silently replaced the site with a bare
# API. Both lines must name the same files as setup-server.sh.
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.preview.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f docker-compose.preview.yml down
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
