<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="DM.Infrastructure.Persistence" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DM.Domain.Core\DM.Domain.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Autofac only for the module that declares this assembly's lifetimes. The
             options packages are for the configuration extension that ships next to
             it, the same pairing the account domain uses. -->
        <PackageReference Include="Autofac" />
        <PackageReference Include="FluentValidation" />
        <PackageReference Include="Microsoft.Extensions.Configuration" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
        <PackageReference Include="Microsoft.Extensions.Options" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    </ItemGroup>
</Project>
