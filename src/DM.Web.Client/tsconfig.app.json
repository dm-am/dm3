{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "src/**/locales/*.json"],
  // Specs live next to the unit they test, so the include above sweeps them in.
  // They belong to tsconfig.vitest.json, which re-adds them with the node and
  // jsdom globals they need; here they would only pull those globals into the
  // project that stands for browser code, where a Node import has to stay an
  // error.
  "exclude": ["src/**/*.spec.ts"],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
