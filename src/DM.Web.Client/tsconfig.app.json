{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "src/**/locales/*.json"],
  // Specs live next to the unit they test, so the include above sweeps them in.
  // They belong to tsconfig.vitest.json, which re-adds them with the node and
  // jsdom globals they need; here they would only pull those globals into the
  // project that stands for browser code, where a Node import has to stay an
  // error.
  //
  // The second entry is the same rule one step out: shared/lib/testing holds
  // what the specs compile a stylesheet with, so it reads sources off disk and
  // imports the sass compiler. Nothing the browser bundle may reach imports
  // it, and under this project its `node:fs` would have to be an error.
  "exclude": ["src/**/*.spec.ts", "src/shared/lib/testing/**"],
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
