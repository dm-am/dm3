{
  "name": "dm-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.2",
    "npm": "11.19.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest --environment jsdom",
    "test:coverage": "vitest run --coverage --environment jsdom",
    "test:conventions": "vitest run --environment jsdom --dir src/gates",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false && vue-tsc --noEmit -p tsconfig.vitest.json --composite false && vue-tsc --noEmit -p tsconfig.e2e.json --composite false && vue-tsc --noEmit -p tsconfig.config.json --composite false",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0 --format ./lint-formatter.mjs",
    "knip": "knip --no-progress"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/vue-virtual": "^3.13.52",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-code": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/vue-3": "^3.33.0",
    "axios": "^1.21.0",
    "dayjs": "^1.11.23",
    "pinia": "^4.1.0",
    "uqr": "^0.1.3",
    "vue": "^3.5.45",
    "vue-final-modal": "^5.0.1",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tiptap/extension-document": "^3.33.0",
    "@tiptap/extension-paragraph": "^3.33.0",
    "@tiptap/extension-text": "^3.33.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.4.2",
    "eslint-plugin-vue": "^10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "knip": "6.44.2",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "nanoid": "^3.3.17"
  }
}
