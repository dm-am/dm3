{
  "name": "dm-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.13.0",
    "npm": "11.6.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest --environment jsdom --root src/",
    "test:coverage": "vitest run --coverage --environment jsdom --root src/",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false && vue-tsc --noEmit -p tsconfig.vitest.json --composite false && vue-tsc --noEmit -p tsconfig.e2e.json --composite false && vue-tsc --noEmit -p tsconfig.config.json --composite false",
    "lint": "eslint . --fix",
    "lint:ci": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@tanstack/vue-virtual": "^3.13.23",
    "@tiptap/core": "^3.30.3",
    "@tiptap/extension-code-block": "^3.30.3",
    "@tiptap/extension-placeholder": "^3.30.3",
    "@tiptap/extension-underline": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "@tiptap/vue-3": "^3.30.3",
    "axios": "^1.7.4",
    "dayjs": "^1.11.12",
    "pinia": "^4.0.3",
    "uqr": "^0.1.3",
    "vue": "^3.5.41",
    "vue-final-modal": "^4.5.4",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.40.0",
    "@tiptap/extension-document": "^3.30.3",
    "@tiptap/extension-paragraph": "^3.30.3",
    "@tiptap/extension-text": "^3.30.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "jsdom": "^24.1.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.3.3",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "nanoid": "^3.3.17"
  }
}
