{
  "name": "dm-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build-only",
    "preview": "vite preview",
    "test:unit": "vitest --environment jsdom --root src/",
    "test:coverage": "vitest run --coverage --environment jsdom --root src/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false && vue-tsc --noEmit -p tsconfig.e2e.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:ci": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path .gitignore --max-warnings 0"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.7",
    "@tanstack/vue-virtual": "^3.13.23",
    "@tiptap/extension-bubble-menu": "^3.15.3",
    "@tiptap/extension-code-block": "^3.15.3",
    "@tiptap/extension-image": "^3.15.3",
    "@tiptap/extension-link": "^3.15.3",
    "@tiptap/extension-placeholder": "^3.15.3",
    "@tiptap/extension-underline": "^3.15.3",
    "@tiptap/pm": "^3.15.3",
    "@tiptap/starter-kit": "^3.15.3",
    "@tiptap/vue-3": "^3.15.3",
    "@vee-validate/yup": "^4.13.2",
    "@vuepic/vue-datepicker": "^12.1.0",
    "axios": "^1.7.4",
    "dayjs": "^1.11.12",
    "pinia": "^2.2.2",
    "vee-validate": "^4.13.2",
    "vue": "^3.4.38",
    "vue-final-modal": "^4.5.4",
    "vue-router": "^4.4.3",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@rushstack/eslint-patch": "^1.10.4",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.4.1",
    "@types/qs": "^6.9.15",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vitest/coverage-v8": "^2.0.5",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.56.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-vue": "^9.27.0",
    "jsdom": "^24.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "sass": "^1.77.8",
    "sass-loader": "^16.0.0",
    "start-server-and-test": "^2.0.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^2.0.5",
    "vue-tsc": "^2.0.29"
  }
}
