<Project Sdk="Microsoft.NET.Sdk">

  <!--
    BBCodeParser 1.0.0, vendored from github.com/quilin/BBCodeParser (MIT, see
    LICENSE) at commit c2ccefdf9d, the state the package was built from: the
    default branch does not compile. Vendored rather than restored: the only
    release on NuGet ships no sources and no licence expression, so nothing in it
    can be read or fixed. A project of its own, so that the container scan of
    DM.Infrastructure.Core finds no second IBbParser and the nullable policy stays
    off here. The assembly name is the package's.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Predates nullable annotations; annotating it could change what it does to stored text. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>

</Project>
