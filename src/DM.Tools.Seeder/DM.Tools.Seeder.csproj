<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <!-- CompositionRootShould builds the container of the entry point. -->
    <ItemGroup>
        <InternalsVisibleTo Include="DM.Architecture.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DM.Domain.Account\DM.Domain.Account.csproj" />
        <ProjectReference Include="..\DM.Domain.Blog\DM.Domain.Blog.csproj" />
        <ProjectReference Include="..\DM.Domain.Community\DM.Domain.Community.csproj" />
        <ProjectReference Include="..\DM.Domain.Game\DM.Domain.Game.csproj" />
        <ProjectReference Include="..\DM.Domain.Core\DM.Domain.Core.csproj" />
        <ProjectReference Include="..\DM.Infrastructure.Core\DM.Infrastructure.Core.csproj" />
        <ProjectReference Include="..\DM.Infrastructure.Persistence\DM.Infrastructure.Persistence.csproj" />
    </ItemGroup>

    <!-- None, not Content: outside the Web SDK appsettings.json is not a Content item. -->
    <ItemGroup>
        <None Update="appsettings.json">
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <!-- The localhost credentials stay out of the image. -->
        <None Update="appsettings.Development.json">
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Assets\Seed\diopside.jpg" />
        <EmbeddedResource Include="Assets\Seed\Chuck.png" />
        <EmbeddedResource Include="Assets\Seed\SolohinLex.jpg" />
        <EmbeddedResource Include="Assets\Seed\SolohinLex.bbcode" />
    </ItemGroup>

</Project>
