@* Only moderation restores an account, and a removed one cannot sign in: the button leads to support. *@
<EmailLayout Title="Аккаунт удален">
    <p style="@EmailConstants.ParagraphStyles">
        Если аккаунт был удален по ошибке, то вы можете обратиться в поддержку
    </p>
    <ActionButton Url="@Model.SupportUrl">Написать в поддержку</ActionButton>
</EmailLayout>

@code {

    /// <summary>Данные письма</summary>
    [Parameter]
    public AccountRemovedViewModel Model { get; set; } = null!;

}
