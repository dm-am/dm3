@*
    Nothing is left to cancel after the move, so the only way back is support.
    Same order as EmailChangeWarning: the box, the line under it, then the button that does it.
*@
<EmailLayout Title="Почта изменена">
    <div style="@EmailConstants.BoxStyles">
    <table style="@EmailConstants.FactTableStyles">
        <tr>
            <td style="@EmailConstants.FactLabelStyles">Прежний адрес</td>
            <td style="@EmailConstants.FactValueStyles">@Model.PreviousEmail</td>
        </tr>
        <tr>
            <td style="@EmailConstants.FactLabelStyles">Новый адрес</td>
            <td style="@EmailConstants.FactValueStyles">@Model.NewEmail</td>
        </tr>
    </table>
    </div>
    <p style="@EmailConstants.ParagraphStyles">
        Если это были не вы, срочно обратитесь в поддержку для восстановления доступа
    </p>
    <ActionButton Url="@Model.SupportUrl">Написать в поддержку</ActionButton>
</EmailLayout>

@code {

    /// <summary>Данные письма</summary>
    [Parameter]
    public EmailChangeCompletedViewModel Model { get; set; } = null!;

}
