    <LinkLifetime Hours="@Model.LinkLifetimeHours">Ссылка для выбора имени и завершения регистрации</LinkLifetime>
    <ActionButton Url="@Model.ConfirmationLinkUrl">Выбрать имя</ActionButton>
</EmailLayout>

@code {

    /// <summary>Данные письма</summary>
    [Parameter]
    public RegistrationConfirmationViewModel Model { get; set; } = null!;

}
