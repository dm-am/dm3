@*
    Письмо восстановления пароля.
*@
<EmailLayout Title="Восстановление пароля">
    <p style="@EmailConstants.ParagraphStyles">
        Здравствуйте, @Model.Username!
    </p>

    <p style="@EmailConstants.ParagraphStyles">
        Мы получили запрос на смену пароля к вашей учетной записи.
    </p>

    <a href="@Model.ConfirmationLinkUrl" style="@EmailConstants.ButtonStyles">Задать новый пароль</a>

    <p style="@EmailConstants.ParagraphStyles">
        Если кнопка не работает, откройте ссылку вручную:<br/>
        <a href="@Model.ConfirmationLinkUrl">@Model.ConfirmationLinkUrl</a>
    </p>

    <p style="@EmailConstants.ParagraphStyles">
        Если запрос делали не вы, ничего делать не нужно: пароль останется прежним,
        пока по ссылке не задан новый.
    </p>
</EmailLayout>

@code {

    /// <summary>Данные письма</summary>
    [Parameter]
    public PasswordResetConfirmationViewModel Model { get; set; } = null!;

}
