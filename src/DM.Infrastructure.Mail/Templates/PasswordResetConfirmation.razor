@*
    Письмо восстановления пароля.
*@
<EmailLayout Title="Восстановление пароля">
    <p style="@EmailConstants.ParagraphStyles">
        Ссылка для изменения пароля действительна 48 часов
    </p>
    <ActionButton Url="@Model.ConfirmationLinkUrl">Задать новый пароль</ActionButton>
</EmailLayout>

@code {

    /// <summary>Данные письма</summary>
    [Parameter]
    public PasswordResetConfirmationViewModel Model { get; set; } = null!;

}
