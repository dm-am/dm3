@* The heading names the step: the full term does not fit KeepEveryLetterHeadingOnOneLine. *@
<EmailLayout Title="Запрос на отключение">
    <p style="@EmailConstants.ParagraphStyles">
        Было запрошено отключение двухфакторной аутентификации аккаунта, при подтверждении защита отключится по истечении недели
    </p>
    <ActionButton Url="@Model.ConfirmationLinkUrl">Подтвердить отключение</ActionButton>
</EmailLayout>

@code {

    /// <summary>Данные письма</summary>
    [Parameter]
    public TwoFactorRemovalRequestViewModel Model { get; set; } = null!;

}
