@*
    A row the detector could not fill is not printed at all.
    "IP-адрес", because the other letters call a mailbox "адрес".
    The IP address above the country: it names where the login came from, the country is what the reader knows.
*@
<EmailLayout Title="Незнакомое устройство">
    <div style="@EmailConstants.BoxStyles">
    <table style="@EmailConstants.FactTableStyles">
        <tr>
            <td style="@EmailConstants.FactLabelStyles">Когда</td>
            <td style="@EmailConstants.FactValueStyles">@Model.Timestamp</td>
        </tr>
        @if (!string.IsNullOrWhiteSpace(Model.IpAddress))
        {
            <tr>
                <td style="@EmailConstants.FactLabelStyles">IP-адрес</td>
                <td style="@EmailConstants.FactValueStyles">@Model.IpAddress</td>
            </tr>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Country))
        {
            <tr>
                <td style="@EmailConstants.FactLabelStyles">Страна</td>
                <td style="@EmailConstants.FactValueStyles">@Model.Country</td>
            </tr>
        }
        @if (!string.IsNullOrWhiteSpace(Model.DeviceInfo))
        {
            <tr>
                <td style="@EmailConstants.FactLabelStyles">Устройство</td>
                <td style="@EmailConstants.FactValueStyles">@Model.DeviceInfo</td>
            </tr>
        }
    </table>
    </div>
</EmailLayout>

@code {

    /// <summary>Данные письма</summary>
    [Parameter]
    public SuspiciousLoginViewModel Model { get; set; } = null!;

}
