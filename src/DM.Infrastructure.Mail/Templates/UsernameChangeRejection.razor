@* The reason is free text, written through Razor so that its markup arrives as text. *@
<EmailLayout Title="Смена имени отклонена">
    @if (string.IsNullOrEmpty(Model.Reason))
    {
        <p style="@EmailConstants.ParagraphStyles">
            Модератор не назвал причину
        </p>
    }
    else
    {
        <div style="@EmailConstants.BoxStyles">@Model.Reason</div>
    }
</EmailLayout>

@code {

    /// <summary>Данные письма</summary>
    [Parameter]
    public UsernameChangeRejectionViewModel Model { get; set; } = null!;

}
