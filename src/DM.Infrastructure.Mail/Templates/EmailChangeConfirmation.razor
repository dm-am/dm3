@* The new address may be a typo, so the line tells a stranger there is nothing to do. *@
<EmailLayout Title="Смена почты">
    <p style="@EmailConstants.ParagraphStyles">
        Если это были не вы, просто проигнорируйте это письмо
    </p>
    <ActionButton Url="@Model.ConfirmationLinkUrl">Подтвердить новую почту</ActionButton>
</EmailLayout>

@code {

    /// <summary>Данные письма</summary>
    [Parameter]
    public EmailChangeConfirmationViewModel Model { get; set; } = null!;

}
