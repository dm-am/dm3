@*
    Письмо о назначенном отключении двухфакторной аутентификации. Несет срок и
    ссылку отмены; отменяет отключение также любой успешный вход с
    подтверждением второго шага.
*@
<EmailLayout Title="Отключение назначено">
    <p style="@EmailConstants.ParagraphStyles">
        Отключение двухфакторной аутентификации запланировано на @Model.Due, но будет автоматически отменено при успешном входе
    </p>
    <ActionButton Url="@Model.CancellationLinkUrl">Отменить отключение</ActionButton>
</EmailLayout>

@code {

    /// <summary>Данные письма</summary>
    [Parameter]
    public TwoFactorRemovalScheduledViewModel Model { get; set; } = null!;

}
