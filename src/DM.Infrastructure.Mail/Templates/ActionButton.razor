@*
    The same path through the other site addresses: the token sits after the hash and cannot be carried by hand.
    The door is named by its full name (SiteAddress.Title), as is, neither declined nor lowercased:
    the sentence has no heading over it to tell what "Основной" is.
    Only when the letter is built on a site address: from a stand host it would promise a page the proxy lacks.
*@
@using DM.Domain.Core.Site
<a href="@Url" style="@EmailConstants.ButtonStyles">@ChildContent</a>
@foreach (var address in Alternates)
{
    <p style="@EmailConstants.AlternateLinkStyles">
        <a href="@Through(address.Host)" style="@EmailConstants.AlternateLinkAnchorStyles">Ссылка через @address.Title</a>
    </p>
}

@code {

    /// <summary>Адрес, на который ведет кнопка</summary>
    [Parameter]
    public string Url { get; set; } = null!;

    /// <summary>Надпись на кнопке</summary>
    [Parameter]
    public RenderFragment ChildContent { get; set; } = null!;

    private Uri Address => new(Url);

    /// <summary>Остальные двери сайта, если письмо построено от одной из них</summary>
    private IReadOnlyList<SiteAddress> Alternates =>
        SiteAddresses.Hosts.Contains(Address.Host)
            ? SiteAddresses.All
                .Where(address => address.Host != Address.Host)
                .ToList()
            : [];

    /// <summary>Тот же путь и тот же токен, только через другой хост</summary>
    private string Through(string host) =>
        new UriBuilder(Address) { Host = host, Port = -1 }.Uri.ToString();

}
