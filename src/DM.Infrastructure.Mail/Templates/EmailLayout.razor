@*
    Каркас письма: логотип, колонка чтения, подпись под чертой.

    Логотип идет ссылкой cid:logo — картинка прикреплена к письму как inline-часть
    multipart/related, а не забирается по URL. Так она видна в клиенте, который по
    умолчанию не грузит внешние изображения, и просмотр письма не сообщает нам, что
    его открыли.

    Два параметра, а не один с именем Model, поэтому сканер шаблонов проходит мимо
    этого компонента и не считает его шаблоном письма.
*@
<html lang="ru">
<body style="@EmailConstants.BodyStyles">
<div style="@EmailConstants.ContainerStyles">
    <img src="cid:logo" alt="Dungeon Master" width="180" style="@EmailConstants.LogoStyles"/>

    <h1 style="@EmailConstants.HeadingStyles">@Title</h1>

    @ChildContent

    <hr style="@EmailConstants.RuleStyles"/>
    <p style="@EmailConstants.FooterStyles">
        Письмо отправлено автоматически, отвечать на него не нужно.
    </p>
    @*
        Адреса сайта в подвале письма. Почта — единственный канал, который
        доходит до человека после того, как привычный адрес перестал у него
        открываться: страницу с этим перечнем он к тому моменту уже не загрузит.
        Строка появляется только когда адресов больше одного.
    *@
    @if (SiteHosts.Count > 1)
    {
        <p style="@EmailConstants.FooterStyles">
            Сайт открывается по адресам: @string.Join(", ", SiteHosts)
        </p>
    }
</div>
</body>
</html>

@code {

    /// <summary>Заголовок письма</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Тело письма</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Inject]
    private SiteAddressConfiguration SiteAddresses { get; set; } = null!;

    /// <summary>
    /// Адреса сайта в том виде, в каком их читают и набирают: без схемы и без
    /// завершающей косой черты. Перечень общий для всего продукта, а не
    /// настройка развертывания: настройкой он был списком, который обязано было
    /// заполнить каждое развертывание и не заполняло ни одно. Ссылками не оформлены намеренно — письмо с этим
    /// перечнем читают в том числе тогда, когда часть адресов не отвечает, и
    /// адрес там нужно прочитать, а не нажать.
    /// </summary>
    private IReadOnlyList<string> SiteHosts => DM.Domain.Core.Site.SiteAddresses.Hosts;

}
