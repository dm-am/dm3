@*
    The logo is an inline cid part, shown by a client that blocks external images.
    No parameter is named Model, so the template scan skips this component.
    Outlook for Windows ignores margin: auto; its conditional comment is a string, because Razor drops HTML comments.
*@
<html lang="ru">
<body style="@EmailConstants.BodyStyles">
@((MarkupString)EmailConstants.OutlookColumnOpen)
<div style="@EmailConstants.ContainerStyles">
    <img src="cid:logo" alt="Dungeon Master" width="180" style="@EmailConstants.LogoStyles"/>

    <div style="@EmailConstants.CardStyles">
    <h1 style="@EmailConstants.HeadingStyles">@Title</h1>

    @ChildContent

    <hr style="@EmailConstants.RuleStyles"/>
    @* One footer line: two grey paragraphs under the rule read as a second letter. *@
    <p style="@EmailConstants.FooterStyles">Письмо отправлено автоматически и не требует ответа</p>
    </div>
    @* No list of site addresses: ActionButton links the same step through the others. *@
</div>
@((MarkupString)EmailConstants.OutlookColumnClose)
</body>
</html>

@code {

    /// <summary>Заголовок письма</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Тело письма</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

}
