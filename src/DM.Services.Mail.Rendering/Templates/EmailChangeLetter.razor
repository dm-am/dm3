@using DM.Services.Mail.Rendering.ViewModels

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Подтверждение смены почты</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f5f5f5; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;">

    <div style="display: none; max-height: 0; overflow: hidden;">
        Подтвердите новый адрес почты для аккаунта @Model.Login на DM.AM
    </div>

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f5f5f5; padding: 40px 16px;">
        <tr>
            <td align="center">
                <table width="520" cellpadding="0" cellspacing="0" style="max-width: 100%;">

                    <tr>
                        <td style="padding: 0 0 32px; text-align: center;">
                            <img src="cid:logo"
                                 alt="DM.AM"
                                 width="200"
                                 style="display: inline-block; max-width: 100%; height: auto;" />
                        </td>
                    </tr>

                    <tr>
                        <td style="background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">

                            <div style="height: 4px; background: linear-gradient(90deg, #3c6078 0%, #5080a0 100%);"></div>

                            <table width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="padding: 40px 32px;">

                                        <h1 style="margin: 0 0 8px; font-size: 22px; color: #333; font-weight: 600; text-align: center;">
                                            Подтверждение новой почты
                                        </h1>

                                        <p style="margin: 0 0 32px; font-size: 15px; color: #666; line-height: 1.6; text-align: center;">
                                            <strong>@Model.Login</strong>, вы запросили смену адреса почты.
                                        </p>

                                        <table width="100%" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td align="center">
                                                    <a href="@Model.ConfirmationLinkUrl"
                                                       style="display: inline-block; padding: 14px 40px;
                                                              background-color: #3c6078; color: #ffffff;
                                                              text-decoration: none; border-radius: 6px;
                                                              font-size: 15px; font-weight: 600;">
                                                        Подтвердить почту
                                                    </a>
                                                </td>
                                            </tr>
                                        </table>

                                        <p style="margin: 16px 0 0; font-size: 13px; color: #999; text-align: center;">
                                            Ссылка действительна 24 часа
                                        </p>

                                    </td>
                                </tr>
                            </table>

                        </td>
                    </tr>

                    <tr>
                        <td style="padding: 20px 16px; text-align: center;">
                            <p style="margin: 0 0 12px; font-size: 13px; color: #999;">
                                Если вы не запрашивали смену почты — просто проигнорируйте это письмо.
                            </p>
                            <p style="margin: 0; font-size: 13px; color: #999;">
                                Нужна помощь? Обратитесь в
                                <a href="https://dm.am/support?reason=access" style="color: #3c6078; text-decoration: none; font-weight: 500;">поддержку</a>
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>
</html>
@code {
    [Parameter]
    public required EmailChangeConfirmationViewModel Model { get; set; }
}
