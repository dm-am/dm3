<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Autofac" />
        <PackageReference Include="Autofac.Extensions.DependencyInjection" />
        <PackageReference Include="Jamq.Client.Rabbit.DependencyInjection" />
        <PackageReference Include="Polly" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DM.Domain.Community\DM.Domain.Community.csproj" />
        <ProjectReference Include="..\DM.Domain.Personal\DM.Domain.Personal.csproj" />
        <ProjectReference Include="..\DM.Infrastructure.Core\DM.Infrastructure.Core.csproj" />
        <ProjectReference Include="..\DM.Infrastructure.Persistence\DM.Infrastructure.Persistence.csproj" />
        <ProjectReference Include="..\DM.Infrastructure.Mail\DM.Infrastructure.Mail.csproj" />
        <ProjectReference Include="..\DM.Infrastructure.Messaging\DM.Infrastructure.Messaging.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The Development overlay holds the localhost credentials, and it stays out
             of the image. A deployed host runs as Production and would not read the
             file anyway; not shipping it is what makes that a fact rather than a
             property of one environment variable. -->
        <Content Update="appsettings.Development.json">
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- The routing and processor tests live next to the broker they exercise,
             in DM.Infrastructure.Messaging.Tests, and the processor together with its
             collaborators is internal. The blanket grant in Directory.Build.props
             covers only DM.Workers.NotificationDispatcher.Tests, which is the tier
             that runs the generators against a database. -->
        <InternalsVisibleTo Include="DM.Infrastructure.Messaging.Tests" />
    </ItemGroup>

</Project>
