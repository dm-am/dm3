<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    </PropertyGroup>

    <ItemGroup>
        <!-- Source generator only: nothing of Mapperly reaches the runtime. -->
        <PackageReference Include="Riok.Mapperly" PrivateAssets="all" />
        <PackageReference Include="AspNetCore.HealthChecks.Npgsql" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DM.Domain.Community\DM.Domain.Community.csproj" />
        <ProjectReference Include="..\DM.Domain.Personal\DM.Domain.Personal.csproj" />
        <ProjectReference Include="..\DM.Infrastructure.Core\DM.Infrastructure.Core.csproj" />
        <ProjectReference Include="..\DM.Infrastructure.Persistence\DM.Infrastructure.Persistence.csproj" />
        <ProjectReference Include="..\DM.Infrastructure.Mail\DM.Infrastructure.Mail.csproj" />
        <ProjectReference Include="..\DM.Infrastructure.Messaging\DM.Infrastructure.Messaging.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The localhost credentials stay out of the image. -->
        <Content Update="appsettings.Development.json">
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <!-- The processor tests live in DM.Infrastructure.Messaging.Tests. -->
        <InternalsVisibleTo Include="DM.Infrastructure.Messaging.Tests" />
    </ItemGroup>

</Project>
